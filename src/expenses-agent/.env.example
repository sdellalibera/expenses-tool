# Foundry chat client (Azure AI Foundry project + model deployment)
FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com
FOUNDRY_MODEL=gpt-4.1

# Azure AI Content Understanding resource
AZURE_CONTENTUNDERSTANDING_ENDPOINT=https://your-cu-resource.cognitiveservices.azure.com/
# Optional: a specific analyzer id (e.g. a prebuilt or custom receipts/invoice analyzer)
# AZURE_CONTENTUNDERSTANDING_ANALYZER_ID=prebuilt-invoice

# MCP servers. Under the Aspire AppHost these are injected via service discovery
# (services__sql-mcp-server__http__0 / services__storagemcp__http__0); set them
# explicitly for standalone runs. The /mcp path is appended automatically.
SQL_MCP_URL=http://localhost:5000
STORAGE_MCP_URL=http://localhost:5099

# Entra token scopes for the MCP endpoints (when secured). The agent acquires a
# token via DefaultAzureCredential and sends it as Authorization: Bearer. Leave
# unset for local/anonymous MCP servers.
# SQL_MCP_SCOPE=api://<sql-mcp-app-id>/.default
# STORAGE_MCP_SCOPE=api://<storage-mcp-app-id>/.default

# Web host binding
HOST=0.0.0.0
PORT=8080
