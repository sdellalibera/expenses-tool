{
  "$schema": "https://github.com/Azure/data-api-builder/releases/latest/download/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('MSSQL_CONNECTION_STRING')",
    "options": {
      "set-session-context": false
    }
  },
  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/api",
      "request-body-strict": true
    },
    "graphql": {
      "enabled": true,
      "path": "/graphql",
      "allow-introspection": true
    },
    "mcp": {
      "enabled": true,
      "dml-tools": {
        "read": { "enabled": true },
        "create": { "enabled": true },
        "update": { "enabled": true },
        "delete": { "enabled": true }
      }
    },
    "host": {
      "cors": {
        "origins": [],
        "allow-credentials": false
      },
      "authentication": {
        "provider": "StaticWebApps"
      },
      "mode": "development"
    }
  },
  "entities": {
    "Documents": {
      "source": {
        "object": "dbo.Documents",
        "type": "table"
      },
      "description": "A source document analyzed by the Content Understanding 'MultipleInvoices' analyzer. One document may contain many invoices.",
      "permissions": [
        { "role": "anonymous", "actions": [{ "action": "*" }] }
      ],
      "fields": [
        { "name": "Id", "primary-key": true, "description": "Document Id (auto-generated)" },
        { "name": "SourceName", "description": "Original file or source name of the analyzed document" },
        { "name": "AnalyzerId", "description": "Content Understanding analyzer id, e.g. 'MultipleInvoices'" },
        { "name": "AnalyzedAt", "description": "UTC timestamp when the document was analyzed" }
      ],
      "relationships": {
        "invoices": {
          "cardinality": "many",
          "target.entity": "Invoices",
          "source.fields": [ "Id" ],
          "target.fields": [ "DocumentId" ]
        }
      }
    },
    "Invoices": {
      "source": {
        "object": "dbo.Invoices",
        "type": "table"
      },
      "description": "A single invoice extracted from a document by the Content Understanding 'MultipleInvoices' analyzer (one row per invoice).",
      "permissions": [
        { "role": "anonymous", "actions": [{ "action": "*" }] }
      ],
      "fields": [
        { "name": "Id", "primary-key": true, "description": "Invoice Id (auto-generated)" },
        { "name": "DocumentId", "description": "FK to the parent Documents row" },
        { "name": "VendorName", "description": "Name of the vendor for this invoice" },
        { "name": "InvoiceDate", "description": "Date of the payment for this invoice" },
        { "name": "PaymentMethod", "description": "Payment method used for this invoice (e.g. Credit Card, Cash, Bank Transfer)" },
        { "name": "TotalAmount", "description": "Total amount paid for this invoice" },
        { "name": "Currency", "description": "Currency of the payment (ISO code)" },
        { "name": "VendorNameConfidence", "description": "Extraction confidence (0-1) reported by Content Understanding for VendorName" },
        { "name": "DateConfidence", "description": "Extraction confidence (0-1) for InvoiceDate" },
        { "name": "PaymentMethodConfidence", "description": "Extraction confidence (0-1) for PaymentMethod" },
        { "name": "TotalAmountConfidence", "description": "Extraction confidence (0-1) for TotalAmount" },
        { "name": "CurrencyConfidence", "description": "Extraction confidence (0-1) for Currency" }
      ],
      "relationships": {
        "document": {
          "cardinality": "one",
          "target.entity": "Documents",
          "source.fields": [ "DocumentId" ],
          "target.fields": [ "Id" ]
        },
        "lineItems": {
          "cardinality": "many",
          "target.entity": "InvoiceLineItems",
          "source.fields": [ "Id" ],
          "target.fields": [ "InvoiceId" ]
        }
      }
    },
    "InvoiceLineItems": {
      "source": {
        "object": "dbo.InvoiceLineItems",
        "type": "table"
      },
      "description": "A line item belonging to an invoice (item name and price).",
      "permissions": [
        { "role": "anonymous", "actions": [{ "action": "*" }] }
      ],
      "fields": [
        { "name": "Id", "primary-key": true, "description": "Line item Id (auto-generated)" },
        { "name": "InvoiceId", "description": "FK to the parent Invoices row" },
        { "name": "ItemName", "description": "Name of the line item" },
        { "name": "Price", "description": "Price for this line item" },
        { "name": "ItemNameConfidence", "description": "Extraction confidence (0-1) for ItemName" },
        { "name": "PriceConfidence", "description": "Extraction confidence (0-1) for Price" }
      ],
      "relationships": {
        "invoice": {
          "cardinality": "one",
          "target.entity": "Invoices",
          "source.fields": [ "InvoiceId" ],
          "target.fields": [ "Id" ]
        }
      }
    }
  }
}
